<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 100% Full Screen Camera -->
    <com.pedro.library.view.OpenGlView
        android:id="@+id/surfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Stream Overlays -->
    <RelativeLayout
        android:id="@+id/overlayContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent">

        <LinearLayout
            android:id="@+id/dragScoreboard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#A6000000"
            android:padding="15dp"
            android:layout_alignParentBottom="true"
            android:layout_alignParentRight="true"
            android:layout_margin="20dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/scoreMainText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IND 245/3 (40.2)"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/scoreSubText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Target: 312 | CRR: 6.08"
                android:textColor="#FFFF00"
                android:textSize="18sp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Top Bar: Timer & End Live -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <ImageView
            android:id="@+id/ivProfilePhoto"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/sym_def_app_icon" />

        <TextView
            android:id="@+id/tvLiveTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="00:00:00"
            android:textColor="#FF5252"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="#80000000"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:visibility="gone" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnGoLive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GO LIVE"
            android:backgroundTint="#D32F2F"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Right Side Floating Tools -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="#60000000"
        android:padding="8dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="60dp">

        <ImageButton
            android:id="@+id/btnSwitchCamera"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_camera_flip"
            android:tint="#FFFFFF"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:layout_marginBottom="16dp" />

        <ImageButton
            android:id="@+id/btnMicToggle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_mic_on"
            android:tint="#FFFFFF"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:layout_marginBottom="16dp" />

        <!-- Layouts Drawer Toggle -->
        <ImageButton
            android:id="@+id/btnToggleLayouts"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_layout_full"
            android:tint="#FFC107"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:layout_marginBottom="16dp" />

        <!-- Overlays Drawer Toggle -->
        <ImageButton
            android:id="@+id/btnToggleOverlays"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_add_text"
            android:tint="#4CAF50"
            android:scaleType="centerInside"
            android:padding="8dp" />
    </LinearLayout>

    <!-- Hidden Layouts Drawer (Slides out left from tools) -->
    <LinearLayout
        android:id="@+id/drawerLayouts"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="80dp"
        android:background="#A6000000"
        android:padding="8dp"
        android:visibility="gone">
        <ImageButton android:id="@+id/btnLayoutFull" android:layout_width="48dp" android:layout_height="48dp" android:background="@android:color/transparent" android:src="@drawable/ic_layout_full" android:tint="#FFF" android:padding="10dp"/>
        <ImageButton android:id="@+id/btnLayoutSplit" android:layout_width="48dp" android:layout_height="48dp" android:background="@android:color/transparent" android:src="@drawable/ic_layout_split_l" android:tint="#FFF" android:padding="10dp"/>
        <ImageButton android:id="@+id/btnLayoutCornerTL" android:layout_width="48dp" android:layout_height="48dp" android:background="@android:color/transparent" android:src="@drawable/ic_layout_tl" android:tint="#FFF" android:padding="10dp"/>
    </LinearLayout>

    <!-- Hidden Overlays Drawer (Slides out left from tools) -->
    <LinearLayout
        android:id="@+id/drawerOverlays"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="80dp"
        android:background="#A6000000"
        android:padding="8dp"
        android:visibility="gone">
        <ImageButton android:id="@+id/btnAddText" android:layout_width="48dp" android:layout_height="48dp" android:background="@android:color/transparent" android:src="@drawable/ic_add_text" android:tint="#4CAF50" android:padding="10dp"/>
        <ImageButton android:id="@+id/btnAddLogo" android:layout_width="48dp" android:layout_height="48dp" android:background="@android:color/transparent" android:src="@drawable/ic_add_logo" android:tint="#FF9800" android:padding="10dp"/>
        <ImageButton android:id="@+id/btnAddWebOverlay" android:layout_width="48dp" android:layout_height="48dp" android:background="@android:color/transparent" android:src="@drawable/ic_web" android:tint="#2196F3" android:padding="10dp"/>
        <ImageButton android:id="@+id/btnToggleScore" android:layout_width="48dp" android:layout_height="48dp" android:background="@android:color/transparent" android:src="@drawable/ic_scoreboard" android:tint="#FFF" android:padding="10dp"/>
        <ImageButton android:id="@+id/btnTextColors" android:layout_width="48dp" android:layout_height="48dp" android:background="@android:color/transparent" android:src="@drawable/ic_colors" android:tint="#FFF" android:padding="10dp"/>
        <ImageButton android:id="@+id/btnRemoveSelected" android:layout_width="48dp" android:layout_height="48dp" android:background="@android:color/transparent" android:src="@drawable/ic_remove" android:tint="#F44336" android:padding="10dp"/>
    </LinearLayout>

    <!-- Task 2: Floating Zoom Pill (Bottom Right) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:background="#80000000"
        android:layout_margin="16dp"
        android:padding="4dp">
        <Button
            android:id="@+id/btnZoomOut"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@android:color/transparent"
            android:text="-"
            android:textSize="24sp"
            android:textColor="#FFF" />
        <Button
            android:id="@+id/btnZoomIn"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@android:color/transparent"
            android:text="+"
            android:textSize="24sp"
            android:textColor="#FFF" />
    </LinearLayout>

    <!-- Studio Chat Panel (Bottom Left) -->
    <LinearLayout
        android:id="@+id/commentsPanel"
        android:layout_width="260dp"
        android:layout_height="180dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentLeft="true"
        android:orientation="vertical"
        android:background="#A6000000"
        android:padding="6dp"
        android:layout_margin="16dp"
        android:visibility="gone">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LIVE CHAT"
            android:textColor="#03A9F4"
            android:textStyle="bold"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />
        <ScrollView
            android:id="@+id/commentsScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <TextView
                android:id="@+id/tvCommentsFeed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </ScrollView>
    </LinearLayout>

    <!-- Floating Chat Toggle -->
    <ImageButton
        android:id="@+id/btnToggleComments"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="16dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_chat"
        android:tint="#FFF"
        android:backgroundTint="#80000000"
        android:padding="10dp"
        android:scaleType="centerInside" />

</RelativeLayout>
