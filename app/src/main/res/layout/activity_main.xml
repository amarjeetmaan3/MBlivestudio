<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#121212">

    <!-- Camera Preview Area -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="7">
        
        <com.pedro.library.view.OpenGlView
            android:id="@+id/surfaceView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
            
        <!-- INTERACTIVE OVERLAY CONTAINER -->
        <!-- इस लेयर में जो भी होगा, वह लाइव स्ट्रीम पर जाएगा और ड्रैग भी होगा -->
        <RelativeLayout
            android:id="@+id/overlayContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent">
            
            <!-- 1. MOVABLE LOGO -->
            <TextView
                android:id="@+id/dragLogo"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:text="MB"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="#E53935"
                android:layout_alignParentTop="true"
                android:layout_alignParentRight="true"
                android:layout_margin="20dp"
                android:visibility="gone"/>

            <!-- 2. MOVABLE TITLE TEXT -->
            <TextView
                android:id="@+id/dragText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MB LIVE STUDIO"
                android:textColor="#FFFF00"
                android:textSize="30sp"
                android:textStyle="bold"
                android:shadowColor="#000000"
                android:shadowDx="3"
                android:shadowDy="3"
                android:shadowRadius="5"
                android:layout_alignParentBottom="true"
                android:layout_alignParentLeft="true"
                android:layout_margin="20dp"
                android:visibility="gone"/>

            <!-- 3. MOVABLE SCOREBOARD -->
            <LinearLayout
                android:id="@+id/dragScoreboard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#A6000000"
                android:padding="15dp"
                android:layout_alignParentBottom="true"
                android:layout_alignParentRight="true"
                android:layout_margin="20dp"
                android:visibility="gone">
                
                <TextView
                    android:id="@+id/scoreMainText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IND 245/3 (40.2)"
                    android:textColor="#FFFFFF"
                    android:textSize="32sp"
                    android:textStyle="bold" />
                    
                <TextView
                    android:id="@+id/scoreSubText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Target: 312 | CRR: 6.08"
                    android:textColor="#FFFF00"
                    android:textSize="18sp" />
            </LinearLayout>
        </RelativeLayout>
    </FrameLayout>

    <!-- Overlay Controls (Right Side) -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="3"
        android:background="#1E1E1E">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="STUDIO CONTROLS"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_marginBottom="20dp"
                android:gravity="center"/>

            <Button
                android:id="@+id/btnTitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SHOW TITLE" />

            <Button
                android:id="@+id/btnScoreboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SHOW SCORECARD" />

            <Button
                android:id="@+id/btnLogo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SHOW LOGO" 
                android:layout_marginBottom="20dp"/>
                
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💡 Tip: Double Tap on any item on the screen to EDIT it. Drag to MOVE it anywhere."
                android:textColor="#4CAF50"
                android:textSize="14sp"
                android:layout_marginBottom="30dp"/>

            <Button
                android:id="@+id/btnGoLive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GO LIVE"
                android:backgroundTint="#D32F2F"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:padding="16dp"/>
                
        </LinearLayout>
    </ScrollView>
</LinearLayout>
