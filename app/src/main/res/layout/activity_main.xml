<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:weightSum="10"
    android:background="#121212">

    <!-- Camera Preview & Overlay Area -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="7">

        <com.pedro.library.view.OpenGlView
            android:id="@+id/surfaceView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <RelativeLayout
            android:id="@+id/overlayContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent">

            <LinearLayout
                android:id="@+id/dragScoreboard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#A6000000"
                android:padding="15dp"
                android:layout_alignParentBottom="true"
                android:layout_alignParentRight="true"
                android:layout_margin="20dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/scoreMainText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IND 245/3 (40.2)"
                    android:textColor="#FFFFFF"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/scoreSubText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Target: 312 | CRR: 6.08"
                    android:textColor="#FFFF00"
                    android:textSize="18sp" />
            </LinearLayout>
        </RelativeLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:orientation="vertical"
            android:layout_margin="12dp">

            <TextView
                android:id="@+id/tvLiveTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00:00"
                android:textColor="#FF5252"
                android:textStyle="bold"
                android:textSize="20sp"
                android:background="#A6000000"
                android:padding="8dp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/commentsPanel"
            android:layout_width="260dp"
            android:layout_height="180dp"
            android:layout_gravity="bottom|start"
            android:orientation="vertical"
            android:background="#A6000000"
            android:padding="6dp"
            android:layout_margin="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LIVE CHAT"
                android:textColor="#03A9F4"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <ScrollView
                android:id="@+id/commentsScrollView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/tvCommentsFeed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </ScrollView>
        </LinearLayout>
    </FrameLayout>

    <!-- Side Panel Controls -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="3"
        android:background="#0F172A"> <!-- Navy Brand Background -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- BROADCAST CARD -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="BROADCAST" android:textColor="#FFC107" android:textStyle="bold" android:textSize="13sp" android:layout_marginBottom="6dp" android:paddingStart="4dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="#1E293B" android:padding="12dp" android:layout_marginBottom="16dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="#0B132B"
                    android:padding="8dp"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:id="@+id/ivProfilePhoto"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@android:drawable/sym_def_app_icon"
                        android:contentDescription="Account" />

                    <TextView
                        android:id="@+id/tvChannelName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="Not signed in"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnGoLive"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="LIVE"
                    android:background="#D32F2F"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="18sp"/>
            </LinearLayout>

            <!-- CAMERA CARD -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CAMERA" android:textColor="#FFC107" android:textStyle="bold" android:textSize="13sp" android:layout_marginBottom="6dp" android:paddingStart="4dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="#1E293B" android:padding="12dp" android:layout_marginBottom="16dp">
                
                <!-- Row 1: Ratio 16:9, Ratio 9:16, Flip, Mic -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="4" android:layout_marginBottom="8dp">
                    <Button
                        android:id="@+id/btnRatio169"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="#4CAF50"
                        android:text="16:9"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"/>
                    <Button
                        android:id="@+id/btnRatio916"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:layout_marginStart="4dp"
                        android:background="#334155"
                        android:text="9:16"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"/>
                    <ImageButton
                        android:id="@+id/btnSwitchCamera"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:layout_marginStart="4dp"
                        android:background="#334155"
                        android:src="@drawable/ic_camera_flip"
                        android:tint="#FFFFFF"
                        android:padding="12dp"
                        android:scaleType="fitCenter"/>
                    <ImageButton
                        android:id="@+id/btnMicToggle"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:background="#334155"
                        android:src="@drawable/ic_mic_on"
                        android:tint="#FFFFFF"
                        android:padding="12dp"
                        android:scaleType="fitCenter"/>
                </LinearLayout>

                <!-- Row 2: Layouts Full + Splits -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="5" android:layout_marginBottom="8dp">
                    <ImageButton android:id="@+id/btnLayoutFull" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="#455A64" android:src="@drawable/ic_layout_full" android:tint="#FFFFFF" android:padding="10dp" android:scaleType="fitCenter"/>
                    <ImageButton android:id="@+id/btnLayoutSplit" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:layout_marginStart="4dp" android:background="#455A64" android:src="@drawable/ic_layout_split_l" android:tint="#FFFFFF" android:padding="10dp" android:scaleType="fitCenter"/>
                    <ImageButton android:id="@+id/btnLayoutSplitRight" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:layout_marginStart="4dp" android:background="#455A64" android:src="@drawable/ic_layout_split_r" android:tint="#FFFFFF" android:padding="10dp" android:scaleType="fitCenter"/>
                    <ImageButton android:id="@+id/btnLayoutSplitTop" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:layout_marginStart="4dp" android:background="#455A64" android:src="@drawable/ic_layout_split_t" android:tint="#FFFFFF" android:padding="10dp" android:scaleType="fitCenter"/>
                    <ImageButton android:id="@+id/btnLayoutSplitBottom" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:layout_marginStart="4dp" android:background="#455A64" android:src="@drawable/ic_layout_split_b" android:tint="#FFFFFF" android:padding="10dp" android:scaleType="fitCenter"/>
                </LinearLayout>

                <!-- Row 3: Layouts Corners -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="5" android:layout_marginBottom="12dp">
                    <ImageButton android:id="@+id/btnLayoutCornerTL" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="#455A64" android:src="@drawable/ic_layout_tl" android:tint="#FFFFFF" android:padding="10dp" android:scaleType="fitCenter"/>
                    <ImageButton android:id="@+id/btnLayoutCornerTR" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:layout_marginStart="4dp" android:background="#455A64" android:src="@drawable/ic_layout_tr" android:tint="#FFFFFF" android:padding="10dp" android:scaleType="fitCenter"/>
                    <ImageButton android:id="@+id/btnLayoutCornerBL" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:layout_marginStart="4dp" android:background="#455A64" android:src="@drawable/ic_layout_bl" android:tint="#FFFFFF" android:padding="10dp" android:scaleType="fitCenter"/>
                    <ImageButton android:id="@+id/btnLayoutCornerBR" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:layout_marginStart="4dp" android:background="#455A64" android:src="@drawable/ic_layout_br" android:tint="#FFFFFF" android:padding="10dp" android:scaleType="fitCenter"/>
                    <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" android:layout_marginStart="4dp"/> <!-- Spacer -->
                </LinearLayout>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ZOOM LEVEL" android:textColor="#888888" android:textSize="10sp" android:layout_marginBottom="4dp"/>
                <SeekBar
                    android:id="@+id/seekZoom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="0"/>
            </LinearLayout>

            <!-- OVERLAYS CARD -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="OVERLAYS" android:textColor="#FFC107" android:textStyle="bold" android:textSize="13sp" android:layout_marginBottom="6dp" android:paddingStart="4dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="#1E293B" android:padding="12dp" android:layout_marginBottom="16dp">
                
                <EditText
                    android:id="@+id/etControlText"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Custom Text Input..."
                    android:textColor="#FFFFFF"
                    android:textColorHint="#888888"
                    android:background="#0B132B"
                    android:padding="12dp"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp"/>

                <!-- Row 1: Add Text, Add Logo, Colors, Remove -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="4" android:layout_marginBottom="12dp">
                    <ImageButton android:id="@+id/btnAddText" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="#334155" android:src="@drawable/ic_add_text" android:tint="#4CAF50" android:padding="12dp" android:scaleType="fitCenter"/>
                    <ImageButton android:id="@+id/btnAddLogo" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:layout_marginStart="4dp" android:background="#334155" android:src="@drawable/ic_add_logo" android:tint="#FF9800" android:padding="12dp" android:scaleType="fitCenter"/>
                    <ImageButton android:id="@+id/btnTextColors" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:layout_marginStart="4dp" android:background="#334155" android:src="@drawable/ic_colors" android:tint="#2196F3" android:padding="12dp" android:scaleType="fitCenter"/>
                    <ImageButton android:id="@+id/btnRemoveSelected" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="4dp" android:background="#D32F2F" android:src="@drawable/ic_remove" android:tint="#FFFFFF" android:padding="12dp" android:scaleType="fitCenter"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="8dp">
                    <EditText
                        android:id="@+id/etScoreMain"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:hint="Score Main"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#888888"
                        android:background="#0B132B"
                        android:padding="12dp"
                        android:textSize="14sp"/>
                    <EditText
                        android:id="@+id/etScoreSub"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:hint="Score Sub"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#888888"
                        android:background="#0B132B"
                        android:padding="12dp"
                        android:textSize="14sp"/>
                </LinearLayout>

                <!-- Row 2: Scoreboard, Add Web, Lock Web, Blank -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="4">
                    <ImageButton android:id="@+id/btnToggleScore" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="#334155" android:src="@drawable/ic_scoreboard" android:tint="#FFFFFF" android:padding="12dp" android:scaleType="fitCenter"/>
                    <ImageButton android:id="@+id/btnAddWebOverlay" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:layout_marginStart="4dp" android:background="#334155" android:src="@drawable/ic_web" android:tint="#FFFFFF" android:padding="12dp" android:scaleType="fitCenter"/>
                    <ImageButton android:id="@+id/btnToggleWebLock" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:layout_marginStart="4dp" android:background="#334155" android:src="@drawable/ic_lock" android:tint="#FFFFFF" android:padding="12dp" android:scaleType="fitCenter"/>
                    <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" android:layout_marginStart="4dp"/> <!-- Spacer -->
                </LinearLayout>
            </LinearLayout>

            <!-- CHAT CARD -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CHAT" android:textColor="#FFC107" android:textStyle="bold" android:textSize="13sp" android:layout_marginBottom="6dp" android:paddingStart="4dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="#1E293B" android:padding="12dp" android:layout_marginBottom="16dp">
                
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="4">
                    <ImageButton android:id="@+id/btnToggleComments" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="#334155" android:src="@drawable/ic_chat" android:tint="#FFFFFF" android:padding="12dp" android:scaleType="fitCenter"/>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
