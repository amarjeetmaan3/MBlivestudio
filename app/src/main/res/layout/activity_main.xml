<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:weightSum="10"
    android:background="#121212">

    <!-- Camera Preview & Overlay Area -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="7">

        <com.pedro.library.view.OpenGlView
            android:id="@+id/surfaceView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- overlayContainer = only what gets burned into the RTMP stream -->
        <RelativeLayout
            android:id="@+id/overlayContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent">

            <WebView
                android:id="@+id/webOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/dragScoreboard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#A6000000"
                android:padding="15dp"
                android:layout_alignParentBottom="true"
                android:layout_alignParentRight="true"
                android:layout_margin="20dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/scoreMainText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IND 245/3 (40.2)"
                    android:textColor="#FFFFFF"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/scoreSubText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Target: 312 | CRR: 6.08"
                    android:textColor="#FFFF00"
                    android:textSize="18sp" />
            </LinearLayout>
        </RelativeLayout>

        <!-- STUDIO-ONLY overlay: NOT inside overlayContainer, so it never
             burns into the stream. Purely for the operator. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:orientation="vertical"
            android:layout_margin="12dp">

            <TextView
                android:id="@+id/tvLiveTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00:00"
                android:textColor="#FF5252"
                android:textStyle="bold"
                android:textSize="20sp"
                android:background="#A6000000"
                android:padding="8dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- STUDIO-ONLY live comments panel, bottom-left of preview -->
        <LinearLayout
            android:id="@+id/commentsPanel"
            android:layout_width="260dp"
            android:layout_height="180dp"
            android:layout_gravity="bottom|start"
            android:orientation="vertical"
            android:background="#A6000000"
            android:padding="6dp"
            android:layout_margin="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LIVE CHAT"
                android:textColor="#03A9F4"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <ScrollView
                android:id="@+id/commentsScrollView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/tvCommentsFeed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </ScrollView>
        </LinearLayout>
    </FrameLayout>

    <!-- Side Panel Controls -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="3"
        android:background="#1E1E1E">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Feature 1: Account bar — circular photo + channel name,
                 fixes the old "SIGNED IN AS: long-email" button that broke
                 the row. Not signed in -> tap opens sign-in. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#252525"
                android:padding="10dp"
                android:layout_marginBottom="15dp">

                <ImageView
                    android:id="@+id/ivProfilePhoto"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/sym_def_app_icon"
                    android:contentDescription="Account" />

                <TextView
                    android:id="@+id/tvChannelName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="Not signed in"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- Feature 2: single LIVE button -> opens Go Live dialog -->
            <Button
                android:id="@+id/btnGoLive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LIVE"
                android:backgroundTint="#D32F2F"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:padding="15dp"
                android:layout_marginBottom="15dp"/>

            <!-- Feature 3: Aspect ratio toggle. Locked once streaming. -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="STREAM ASPECT RATIO" android:textColor="#03A9F4" android:textStyle="bold" android:layout_marginBottom="5dp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="15dp">

                <Button
                    android:id="@+id/btnRatio169"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="16:9"
                    android:backgroundTint="#4CAF50"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="5dp"/>

                <Button
                    android:id="@+id/btnRatio916"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="9:16"
                    android:backgroundTint="#333333"
                    android:textColor="#FFFFFF"
                    android:layout_marginStart="5dp"/>
            </LinearLayout>
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="15dp">
                
                <Button
                    android:id="@+id/btnLayoutFull"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="LAYOUT: FULL"
                    android:backgroundTint="#607D8B"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="5dp"/>
                    
                <Button
                    android:id="@+id/btnLayoutSplit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="LAYOUT: SPLIT"
                    android:backgroundTint="#607D8B"
                    android:textColor="#FFFFFF"
                    android:layout_marginStart="5dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="15dp">

                <Button
                    android:id="@+id/btnSwitchCamera"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="FLIP CAM"
                    android:backgroundTint="#2196F3"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="5dp"/>

                <Button
                    android:id="@+id/btnMicToggle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="MIC: ON"
                    android:backgroundTint="#4CAF50"
                    android:textColor="#FFFFFF"
                    android:layout_marginStart="5dp"/>
            </LinearLayout>

            <!-- Feature 4: pinch-to-zoom hint (actual gesture handled on
                 the camera preview itself via ScaleGestureDetector) -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tip: Pinch on camera preview to zoom (affects stream)" android:textColor="#888888" android:textSize="11sp" android:layout_marginBottom="15dp"/>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#444444" android:layout_marginBottom="15dp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CUSTOM TEXT (ADD MULTIPLE)" android:textColor="#4CAF50" android:textStyle="bold"/>
            <EditText
                android:id="@+id/etControlText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Type text here..."
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:background="#333333"
                android:padding="12dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"/>
            <Button android:id="@+id/btnAddText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ADD NEW TEXT TO SCREEN" />

            <!-- Feature 5: per-text color editor -->
            <Button android:id="@+id/btnTextColors" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="TEXT COLORS (SELECTED ITEM)" android:backgroundTint="#607D8B" android:textColor="#FFFFFF" android:layout_marginTop="8dp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PHOTO LOGO (ADD MULTIPLE)" android:textColor="#FF9800" android:textStyle="bold" android:layout_marginTop="15dp"/>
            <Button android:id="@+id/btnAddLogo" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CHOOSE PHOTO FROM GALLERY" android:layout_marginTop="5dp"/>
            <Button android:id="@+id/btnRemoveSelected" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="REMOVE SELECTED ITEM" android:backgroundTint="#E53935" android:textColor="#FFFFFF" android:layout_marginTop="10dp"/>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#444444" android:layout_marginTop="15dp" android:layout_marginBottom="15dp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CRICKET SCORECARD" android:textColor="#9C27B0" android:textStyle="bold"/>
            <EditText android:id="@+id/etScoreMain" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Main Score (ex: IND 245/3)" android:textColor="#FFFFFF" android:textColorHint="#888888" android:background="#333333" android:padding="12dp" android:layout_marginTop="5dp" android:layout_marginBottom="5dp"/>
            <EditText android:id="@+id/etScoreSub" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Sub Text (Target: 312)" android:textColor="#FFFFFF" android:textColorHint="#888888" android:background="#333333" android:padding="12dp" android:layout_marginBottom="5dp"/>
            <Button android:id="@+id/btnToggleScore" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SHOW SCORECARD ON SCREEN" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#444444" android:layout_marginTop="15dp" android:layout_marginBottom="15dp"/>

            <EditText android:id="@+id/etWebUrl" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="https://your-overlay-url.com" android:textColor="#FFFFFF" android:textColorHint="#888888" android:background="#333333" android:padding="12dp" android:inputType="textUri" android:layout_marginBottom="5dp"/>
            <Button android:id="@+id/btnApplyWeb" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SHOW WEB OVERLAY" android:layout_marginBottom="5dp"/>

            <!-- Feature 6: toggle studio-only comments panel -->
            <Button android:id="@+id/btnToggleComments" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SHOW LIVE CHAT (STUDIO ONLY)" android:layout_marginBottom="20dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
