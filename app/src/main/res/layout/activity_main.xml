<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#121212">

    <!-- Camera Preview Area (Left Side - 70%) -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="7">
        
        <com.pedro.library.view.OpenGlView
            android:id="@+id/surfaceView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- Overlay & Stream Controls (Right Side - 30%) -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="3"
        android:background="#1E1E1E">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- TEXT OVERLAYS SECTION -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TEXT &amp; SCORE OVERLAYS"
                android:textColor="#2196F3"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="10dp"/>

            <Button
                android:id="@+id/btnTitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TITLE TEXT (OFF)" />

            <Button
                android:id="@+id/btnScoreboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CRICKET SCORE (OFF)" 
                android:layout_marginBottom="20dp"/>

            <!-- GRAPHICS OVERLAYS SECTION -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GRAPHICS &amp; LOGO"
                android:textColor="#4CAF50"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="10dp"/>

            <Button
                android:id="@+id/btnLogo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CHANNEL LOGO (OFF)" 
                android:layout_marginBottom="30dp"/>

            <!-- MAIN STREAM CONTROL -->
            <Button
                android:id="@+id/btnGoLive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GO LIVE"
                android:backgroundTint="#D32F2F"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:padding="16dp"/>
                
        </LinearLayout>
    </ScrollView>
</LinearLayout>
